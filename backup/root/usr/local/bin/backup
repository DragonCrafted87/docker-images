#!/bin/sh
set -eu

base_backup_name="${BACKUP_NAME:-minecraft-vanillaplusplus-backup}"
# %G and %V are an ISO year and week. They have to stay a pair at a year boundary.
date_stamp="$(date +%G-W%V-%u-%H-%M-%S)"
backup_name="${base_backup_name}-${date_stamp}.tar.xz"
source_path=/mnt/source
dest_dir=/mnt/backups
partial="${dest_dir}/.${backup_name}.partial"

mkdir -p "$dest_dir"
rm -f "$partial"

# -h stores the symlink target. prove.sh compares the archive to that tree.
if ! tar -C "$source_path" -chJf "$partial" .; then
    rm -f "$partial"
    exit 1
fi
mv "$partial" "${dest_dir}/${backup_name}"
